generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  username       String?   @unique
  passwordHash   String
  name           String
  phone          String?
  role           String
  status         String    @default("ACTIVE")
  profilePicture String?
  qualification  String?
  experience     String?
  studentCode    String?   @unique
  dateOfBirth    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions             Session[]
  taughtClasses        Class[]                 @relation("ClassTeacher")
  memberships          ClassMember[]
  quizAttempts         QuizAttempt[]
  submissions          AssignmentSubmission[]
  attendance           Attendance[]
  announcements        Announcement[]          @relation("AnnouncementAuthor")
  createdQuizzes       Quiz[]                  @relation("QuizTeacher")
  createdAssignments   Assignment[]            @relation("AssignmentTeacher")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  remember  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Class {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  subject     String
  teacherId   String?
  teacher     User?     @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  startDate   DateTime?
  endDate     DateTime?
  code        String    @unique
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members       ClassMember[]
  quizzes       Quiz[]
  assignments   Assignment[]
  attendance    Attendance[]
  announcements Announcement[]
  liveMeetings  LiveMeeting[]
}

model LiveMeeting {
  id         String   @id @default(cuid())
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  meetingUrl String
  startsAt   DateTime
  status     String   @default("SCHEDULED")
  createdBy  String?
  studentEmails String @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([classId])
}

model ClassMember {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
}

model Quiz {
  id           String    @id @default(cuid())
  title        String
  description  String    @default("")
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User      @relation("QuizTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  startDate    DateTime?
  endDate      DateTime?
  timeLimitMin Int       @default(30)
  totalMarks   Int       @default(0)
  passingMarks Int       @default(0)
  status       String    @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id             String @id @default(cuid())
  quizId         String
  quiz           Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt         String
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  String
  marks          Int    @default(1)
  sortOrder      Int    @default(0)
  answers        QuizAnswer[]
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int       @default(0)
  status      String    @default("IN_PROGRESS")

  answers QuizAnswer[]

  @@unique([quizId, studentId])
}

model QuizAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selected   String

  @@unique([attemptId, questionId])
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User      @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  totalMarks  Int       @default(100)
  attachment  String?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id             String     @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  filePath       String?
  originalName   String?
  mimeType       String?
  fileSize       Int?
  marks          Float?
  feedback       String?
  status         String     @default("SUBMITTED")
  submittedAt    DateTime   @default(now())
  gradedAt       DateTime?

  @@unique([assignmentId, studentId])
}

model Attendance {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String
  status    String
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([classId, studentId, date])
  @@index([studentId])
  @@index([classId, date])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
